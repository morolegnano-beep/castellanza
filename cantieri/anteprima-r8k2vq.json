 "aggiornamenti": [
  {
   "id": "2026-07-22-avvio",
   "data": "2026-07-22T09:00:00.000Z",
   "titolo": "Al via i lavori dell’interconnessione idrica Est-Ovest",
   "testo": "CAP Holding avvia a Castellanza la posa di circa due chilometri di nuova tubazione dell’acqua potabile tra la parte Est e la parte Ovest della città. Il tracciato interessa via Nizzolina, con una derivazione verso via Lombardia, via Marconi, via Gabrio Piola, via Piave con l’attraversamento del ponte sull’Olona e corso Sempione fino a via Sanguinola. I lavori dureranno circa un anno e avanzeranno per tratte successive. Le modifiche alla viabilità saranno pubblicate su questa pagina man mano che i cantieri si sposteranno.",
   "trattoId": "",
   "tipo": "avviso",
   "inEvidenza": false
  }
 ],
